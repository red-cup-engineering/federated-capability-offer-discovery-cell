{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://red-cup-engineering.github.io/federated-capability-offer-discovery-cell/schemas/capability-offer.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "cell", "sku", "provider", "operation", "law", "agentCard", "authorization", "price", "expiresAt"],
  "properties": {
    "kind": {"const": "org.emsenn.capability-offer.v3"},
    "cell": {"type": "string", "pattern": "^ni:///sha-256;[A-Za-z0-9_-]{43}$"},
    "sku": {"type": "string", "pattern": "^ni:///sha-256;[A-Za-z0-9_-]{43}$"},
    "provider": {"type": "string", "pattern": "^urn:ame:"},
    "operation": {"type": "string", "minLength": 1},
    "law": {"type": "string", "pattern": "^ni:///sha-256;[A-Za-z0-9_-]{43}$"},
    "agentCard": {"type": "string", "format": "uri"},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "grantRequired"],
      "properties": {
        "profile": {"enum": ["OCapN", "none"]},
        "grantRequired": {"type": "boolean"}
      }
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "asset", "amount", "network"],
      "properties": {
        "protocol": {"const": "x402"},
        "asset": {"type": "string", "minLength": 1},
        "amount": {"type": "string", "pattern": "^[0-9]+$"},
        "network": {"type": "string", "minLength": 1}
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signedAgentCard", "packageOperation", "deploymentHealth", "resourceMeter", "settlementReturn"],
      "properties": {
        "signedAgentCard": {"$ref": "#/$defs/coordinate"},
        "packageOperation": {"$ref": "#/$defs/coordinate"},
        "deploymentHealth": {"$ref": "#/$defs/coordinate"},
        "resourceMeter": {"$ref": "#/$defs/coordinate"},
        "settlementReturn": {"$ref": "#/$defs/coordinate"}
      }
    },
    "expiresAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "coordinate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "href"],
          "properties": {
            "kind": {"const": "reference"},
            "href": {"type": "string", "format": "uri"},
            "operation": {"type": "string", "minLength": 1},
            "consumes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "emits": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "invocation": {"type": "string", "format": "uri"},
            "currentState": {"type": "string", "format": "uri"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "coordinate", "state", "reason"],
          "properties": {
            "kind": {"const": "org.emsenn.capability-offer.coordinate-residual.v1"},
            "coordinate": {"enum": ["signedAgentCard", "packageOperation", "deploymentHealth", "resourceMeter", "settlementReturn"]},
            "state": {"enum": ["unknown", "missing", "unreachable"]},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  }
}
