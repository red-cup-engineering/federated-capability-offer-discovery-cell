{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://red-cup-engineering.github.io/federated-capability-offer-discovery-cell/schemas/discovery-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "requestId", "operation", "observer", "evaluatedAt", "maximumCandidates", "endpoints"],
  "properties": {
    "kind": {"const": "org.emsenn.capability-offer-discovery.request.v1"},
    "requestId": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "observer": {"type": "string", "format": "uri"},
    "evaluatedAt": {"type": "string", "format": "date-time"},
    "maximumCandidates": {"type": "integer", "minimum": 1, "maximum": 128},
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["outbox", "actor", "agentCard"],
        "properties": {
          "outbox": {"type": "string", "format": "uri"},
          "actor": {"type": "string", "format": "uri"},
          "agentCard": {"type": "string", "format": "uri"}
        }
      }
    }
  }
}

